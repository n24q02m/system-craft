---
import "../styles/global.css";
import { T, LABEL, ACTIVE_LANGS, type Lang } from "../i18n";

interface Props {
  title: string;
  description: string;
  lang: Lang;
  /** Đường dẫn tương đối trong cùng bài, để chuyển ngôn ngữ giữ nguyên vị trí. */
  altPath?: string;
}
const { title, description, lang, altPath = "" } = Astro.props;
const base = import.meta.env.BASE_URL;
const t = T[lang];
const others = ACTIVE_LANGS.filter((l) => l !== lang);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow, noarchive, nosnippet, noimageindex, notranslate" />
    <meta name="googlebot" content="noindex, nofollow, noarchive, nosnippet, noimageindex" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    {
      ACTIVE_LANGS.map((l) => (
        <link rel="alternate" hreflang={l} href={`${base}${l}/${altPath}`} />
      ))
    }
    <script is:inline>
      (() => {
        const saved = localStorage.getItem("theme");
        if (saved === "dark" || saved === "light") {
          document.documentElement.setAttribute("data-theme", saved);
        }
      })();
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href={`${base}${lang}/`}>System<span>·</span>Craft</a>
        <nav class="nav">
          <a href={`${base}${lang}/`}>{t.navPosts}</a>
          <a href={`${base}${lang}/about/`}>{t.navAbout}</a>
          {
            others.map((l) => (
              <a href={`${base}${l}/${altPath}`} class="lang-link">
                {LABEL[l]}
              </a>
            ))
          }
          <button class="theme-toggle" id="theme-toggle" type="button" aria-label={t.toggleTheme}>
            {t.toggleTheme}
          </button>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <p>{t.footer}</p>
      </div>
    </footer>

    <script is:inline>
      document.getElementById("theme-toggle")?.addEventListener("click", () => {
        const root = document.documentElement;
        const current =
          root.getAttribute("data-theme") ||
          (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
        const next = current === "dark" ? "light" : "dark";
        root.setAttribute("data-theme", next);
        localStorage.setItem("theme", next);
      });
    </script>
  </body>
</html>
