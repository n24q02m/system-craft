---
import "../styles/global.css";
import "../styles/diagram.css";
import { T, LABEL, ACTIVE_LANGS, type Lang } from "../i18n";

interface Props {
  title: string;
  description: string;
  lang: Lang;
  altPath?: string;
}
const { title, description, lang, altPath } = Astro.props;
const base = import.meta.env.BASE_URL;
const t = T[lang];
const others = ACTIVE_LANGS.filter((l) => l !== lang);
const hasAlt = altPath !== undefined && altPath !== null;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow, noarchive, nosnippet, noimageindex, notranslate" />
    <meta name="googlebot" content="noindex, nofollow, noarchive, nosnippet, noimageindex" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    {
      hasAlt ? (
        ACTIVE_LANGS.map((l) => (
          <link rel="alternate" hreflang={l} href={`${base}${l}/${altPath}`} />
        ))
      ) : (
        <link rel="alternate" hreflang={lang} href={Astro.url.pathname} />
      )
    }
    <script is:inline>
      (() => {
        const saved = localStorage.getItem("theme");
        if (saved === "dark" || saved === "light") {
          document.documentElement.setAttribute("data-theme", saved);
        }
      })();
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href={`${base}${lang}/`}>System<span>·</span>Craft</a>
        <nav class="nav">
          <a href={`${base}vi/book/`}>{t.navBook}</a>
          <a href={`${base}${lang}/cases/`}>{t.navCases}</a>
          <a href={`${base}vi/paths/`}>{t.navPaths}</a>
          <a href={`${base}vi/cards/`}>{t.navCards}</a>
          <a href={`${base}vi/triage/`}>{t.navTriage}</a>
          <a href={`${base}${lang}/tools/`}>{t.navTools}</a>
          <a href={`${base}${lang}/search/`}>{t.navSearch}</a>
          <a href={`${base}${lang}/status/`}>{t.navStatus}</a>
          <a href={`${base}${lang}/about/`}>{t.navAbout}</a>
          <form class="header-search" action={`${base}${lang}/search/`} method="get">
            <input type="search" name="q" placeholder={t.searchPlaceholder} aria-label={t.navSearch} />
          </form>
          {
            hasAlt &&
              others.map((l) => (
                <a href={`${base}${l}/${altPath}`} class="lang-link">
                  {LABEL[l]}
                </a>
              ))
          }
          <button class="theme-toggle" id="theme-toggle" type="button" aria-label={t.toggleTheme}>
            {t.toggleTheme}
          </button>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <p>{t.footer}</p>
      </div>
    </footer>

    <div id="gloss-popover" class="gloss-popover" role="tooltip" hidden></div>

    <script is:inline>
      document.getElementById("theme-toggle")?.addEventListener("click", () => {
        const root = document.documentElement;
        const current =
          root.getAttribute("data-theme") ||
          (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
        const next = current === "dark" ? "light" : "dark";
        root.setAttribute("data-theme", next);
        localStorage.setItem("theme", next);
      });

      (() => {
        const pop = document.getElementById("gloss-popover");
        if (!pop) return;
        const show = (el) => {
          const term = el.getAttribute("data-term") || el.textContent;
          const vi = el.getAttribute("data-vi") || "";
          const en = el.getAttribute("data-en") || "";
          pop.innerHTML =
            `<strong>${term}</strong><div class="gp-vi">${vi}</div>` +
            (en && en !== vi ? `<div class="gp-en">${en}</div>` : "");
          const r = el.getBoundingClientRect();
          pop.style.left = `${Math.max(12, Math.min(window.innerWidth - 340, r.left))}px`;
          pop.style.top = `${r.bottom + window.scrollY + 8}px`;
          pop.hidden = false;
        };
        const hide = () => { pop.hidden = true; };
        document.addEventListener("mouseover", (e) => {
          const abbr = e.target instanceof Element ? e.target.closest("abbr.gloss") : null;
          if (abbr) show(abbr);
        });
        document.addEventListener("mouseout", (e) => {
          const abbr = e.target instanceof Element ? e.target.closest("abbr.gloss") : null;
          if (abbr) hide();
        });
        document.addEventListener("focusin", (e) => {
          const abbr = e.target instanceof Element ? e.target.closest("abbr.gloss") : null;
          if (abbr) show(abbr);
        });
        document.addEventListener("focusout", hide);
      })();
    </script>
  </body>
</html>
