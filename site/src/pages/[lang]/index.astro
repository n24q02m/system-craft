---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import { ACTIVE_LANGS, T, type Lang } from "../../i18n";
import { loadStatusSnapshot } from "../../lib/atlas";

export async function getStaticPaths() {
  return ACTIVE_LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = T[lang];
const base = import.meta.env.BASE_URL;
const snap = loadStatusSnapshot();
const posts = (
  await getCollection("blog", ({ data, id }) => !data.draft && id.startsWith(`${lang}/`))
).sort((a, b) => a.data.order - b.data.order);
---

<Base title={t.siteTitle} description={t.siteDescription} lang={lang} altPath="">
  <div class="wrap">
    <div class="index-head">
      <div class="eyebrow">SA-2028.1</div>
      <h1>{lang === "vi" ? "System Craft — Sổ tay Hệ thống & Case Studies" : "System Craft — Fieldbook & Case Studies"}</h1>
      <p>{t.siteDescription}</p>
    </div>

    <div class="hub-grid">
      <a class="hub-card" href={`${base}vi/book/`}>
        <div class="eyebrow">{lang === "vi" ? "Tập I–IV · 145 chương + Tầng học" : "Volumes I–IV · 145 Chapters (VI)"}</div>
        <h2>{lang === "vi" ? "Sổ tay Kiến trúc Hệ thống" : "Systems Architecture Fieldbook"}</h2>
        <p>{lang === "vi"
          ? "145 chương P0–P14, 30 chương xương sống ★, 15 quiz cụm, 15 lab, 60 câu nâng cao và từ điển song ngữ."
          : "145 chapters covering hardware, kernels, datastores, distributed systems, cloud, SRE, security, and AI serving."}</p>
      </a>
      <a class="hub-card" href={`${base}${lang}/cases/`}>
        <div class="eyebrow">{lang === "vi" ? "Tập V · 6 hệ thống thực chiến" : "Volume V · 6 Bilingual Case Studies"}</div>
        <h2>{lang === "vi" ? "Case Studies Học máy & Dữ liệu" : "ML & Data Production Case Studies"}</h2>
        <p>{lang === "vi"
          ? "Phân tích kiến trúc, bài toán gốc, chuẩn ngành và nguyên tắc giữ lại sau 6 hệ thống thật."
          : "Deep technical retrospectives with SVG architecture diagrams and cross-links into fieldbook chapters."}</p>
      </a>
      <a class="hub-card" href={`${base}vi/paths/`}>
        <div class="eyebrow">{lang === "vi" ? "3 Persona · Theo dõi tiến độ" : "3 Persona Tracks"}</div>
        <h2>{lang === "vi" ? "Lộ trình Học theo Vai" : "Role-Based Roadmaps"}</h2>
        <p>{lang === "vi"
          ? "Tuyến (a) Người mới 16 tuần, (b) Backend 1–3 năm, (c) Infra/Platform — lưu tiến độ tại trình duyệt."
          : "Structured reading paths for (a) newcomers, (b) backend engineers, and (c) infra leads."}</p>
      </a>
      <a class="hub-card" href={`${base}vi/cards/`}>
        <div class="eyebrow">{lang === "vi" ? "Micropaedia · 145 Cards + 493 Flashcards" : "Micropaedia · 145 Cards + 493 Flashcards"}</div>
        <h2>{lang === "vi" ? "Thẻ Tra cứu & Lật Ôn tập" : "Reference Cards & Interactive Flashcards"}</h2>
        <p>{lang === "vi"
          ? "145 thẻ quyết định/số liệu/lỗi, bộ lật 433 Tự chấm + 60 QA nâng cao và 3 danh mục tổng hợp."
          : "145 compact chapter summary cards, 493 interactive flashcards, plus 3 searchable cross-indexes (VI)."}</p>
      </a>
      <a class="hub-card" href={`${base}vi/triage/`}>
        <div class="eyebrow">{lang === "vi" ? "Trade-off · 5 Ca Triage · 5 Công cụ tính" : "Trade-offs · 5 Triage Walks · Calculators"}</div>
        <h2>{lang === "vi" ? "Ranh giới Quy mô, Triage & 5 Máy tính" : "Scale Boundaries, Incident Triage & Calculators"}</h2>
        <p>{lang === "vi"
          ? "Startup / Scale-up / Enterprise (P15-05), 5 ca điều tra sự cố thực chiến (P15-06) và bộ tính định lượng."
          : "When solutions fail by scale tier, 5 incident triage walkthroughs (VI), and interactive engineering calculators."}</p>
      </a>
      <a class="hub-card" href={`${base}${lang}/tools/`}>
        <div class="eyebrow">{lang === "vi" ? "Tính nhanh · Offline JS" : "Zero-Network Tools"}</div>
        <h2>{lang === "vi" ? "5 Công cụ Tính Định lượng Hệ thống" : "5 Interactive System Sizing Calculators"}</h2>
        <p>{lang === "vi"
          ? "Latency Budget, RAID Rebuild URE, TCP BDP, Hàng đợi Little và LLM KV-Cache / Token Economics."
          : "Latency budget, RAID URE rebuild risk, TCP BDP window, Little's Law queue, and LLM KV-cache estimator."}</p>
      </a>
      <a class="hub-card" href={`${base}vi/indexes/`}>
        <div class="eyebrow">{lang === "vi" ? "139 Quyết định · 68 Sự cố · CS2023" : "139 Decisions · 68 Incidents · CS2023"}</div>
        <h2>{lang === "vi" ? "3 Bảng Chỉ mục Tra cứu Toàn sách" : "Decisions, Incidents & CS2023 Indexes"}</h2>
        <p>{lang === "vi"
          ? "Tra theo ID quyết định, triệu chứng sự cố kèm lệnh chẩn 15 giây đầu tiên, và ánh xạ giáo trình CS2023."
          : "Searchable lookup tables across architectural decisions, incident diagnostic commands, and CS2023 mapping."}</p>
      </a>
      <a class="hub-card" href={`${base}${lang}/search/`}>
        <div class="eyebrow">{lang === "vi" ? `${snap.glossaryCount}+ thuật ngữ · Offline Pagefind` : `${snap.glossaryCount}+ terms · Offline Index`}</div>
        <h2>{lang === "vi" ? "Tra cứu Toàn văn & Trạng thái" : "Offline Full-Text Search & Status"}</h2>
        <p>{lang === "vi"
          ? `Tìm kiếm 100% cục bộ bằng Pagefind trên toàn bộ 145 chương + case studies. Ledger verified ${snap.latestVerified}.`
          : `Zero-network Pagefind full-text index across all chapters and essays. Ledger verified ${snap.latestVerified}.`}</p>
      </a>
    </div>

    <h2>{lang === "vi" ? "Case Studies" : "Case Studies"}</h2>
    {
      posts.map((post) => {
        const slug = post.id.replace(`${lang}/`, "");
        return (
          <a class="entry" href={`${base}${lang}/posts/${slug}/`}>
            <div class="entry-code">{post.data.field}</div>
            <div>
              <h2>{post.data.title}</h2>
              <p>{post.data.description}</p>
              <div class="topics">
                {post.data.topics.map((x) => (
                  <span class="topic">{x}</span>
                ))}
              </div>
            </div>
          </a>
        );
      })
    }
  </div>
</Base>
